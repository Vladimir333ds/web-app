# Configure these as environment variables in Render for production.
# For local PowerShell, set them in your terminal before running npm start.
PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,https://your-frontend-domain.example
ADSBLOL_API_KEY=
DB_HOST=your-railway-mysql-host
DB_PORT=3306
DB_USER=your-railway-mysql-user
DB_PASSWORD=your-railway-mysql-password
DB_NAME=your-railway-database-name
